#!/usr/bin/env perl
# Fake Linux `secret-tool` (libsecret) for end-to-end tests. ccx must never
# use the real Secret Service in a test.
#
# The store has one file for each item in FAKE_SECRET_DIR (default
# "$HOME/.fake-secrets"), the same store as the fake `security`. Only the
# attributes `service ccx-* account ccx` are allowed.
# - `secret-tool store --label=L service S account ccx` reads the key from
#   stdin.
# - `secret-tool lookup service S account ccx` prints the key with no
#   newline. It exits 1 when the item is not there.
# - `secret-tool clear service S account ccx` deletes the item.
# FAKE_SECRET_FAIL makes each call fail like a system with no D-Bus.
use strict;
use warnings;

sub fail { print STDERR "secret-tool: $_[0]\n"; exit 1; }

fail("Cannot autolaunch D-Bus without X11 \$DISPLAY") if $ENV{FAKE_SECRET_FAIL};
my $dir = $ENV{FAKE_SECRET_DIR} // "$ENV{HOME}/.fake-secrets";
my $command = shift @ARGV // fail("no command");
shift @ARGV if $command eq 'store' && ($ARGV[0] // '') =~ /^--label=/;
my %attr = @ARGV;
my $service = $attr{service} // fail("no service");
fail("not a ccx item: $service") unless $service =~ /^ccx-[a-z0-9][a-z0-9_-]*$/;
fail("the account is not ccx") unless ($attr{account} // '') eq 'ccx';
fail("unexpected attributes") unless keys %attr == 2;

if ($command eq 'store') {
    local $/;
    my $key = <STDIN>;
    mkdir $dir;
    open(my $fh, '>', "$dir/$service") or fail("cannot write: $!");
    print $fh $key;
    close($fh);
    exit 0;
}
if ($command eq 'lookup') {
    open(my $fh, '<', "$dir/$service") or exit 1;
    local $/;
    print scalar <$fh>;
    exit 0;
}
if ($command eq 'clear') {
    unlink "$dir/$service";
    exit 0;
}
fail("unexpected command: $command");
