#!/usr/bin/env perl
# Fake `claude` for end-to-end tests.
#
# - `claude auth status --json` prints a synthetic login status. The email
#   is "main@example.com" when CLAUDE_CONFIG_DIR is not set. Otherwise it is
#   "<suffix>@example.com", where the dir name is ".claude-<suffix>".
#   A dir name that contains "loggedout" gives `"loggedIn": false`.
#   When the dir has the file ".fake-login" (from `auth login`), the
#   status is logged in with the email in that file.
# - `claude auth login [--email E]` needs CLAUDE_CONFIG_DIR. It writes
#   "<dir>/.fake-login" with the email FAKE_LOGIN_EMAIL, else E, else
#   "<suffix>@example.com". It also writes "<dir>/.claude.json" with
#   `oauthAccount.organizationRateLimitTier` FAKE_LOGIN_TIER (default
#   "default_claude_max_5x") and `organizationType` FAKE_LOGIN_ORG_TYPE
#   (default "claude_max"). FAKE_LOGIN_FAIL makes it fail with exit 1.
# - `claude auth logout` removes "<dir>/.fake-login" and writes the file
#   "<dir>/.fake-logout", where dir is CLAUDE_CONFIG_DIR, else HOME.
#   FAKE_LOGOUT_FAIL makes it fail with exit 1.
# - When FAKE_CLAUDE_VERSION is set, `claude --version` prints its value.
#   When FAKE_LOGGED_OUT is set, all accounts are logged out.
# - `claude -p /usage ...` prints synthetic stream-json events. The
#   `limits[]` array is FAKE_USAGE_LIMITS (JSON) when it is set. A dir name
#   that contains "nousage" fails with exit 1. A dir name that contains
#   "slow" sleeps for 30 seconds first. FAKE_USAGE_SLEEP sleeps for that
#   number of seconds first. A dir name that contains "badjson" prints text
#   that is not JSON.
# - `claude mcp add-json -s user NAME JSON` adds the server NAME to
#   `mcpServers` in "<CLAUDE_CONFIG_DIR>/.claude.json" (or "~/.claude.json"
#   when CLAUDE_CONFIG_DIR is not set). It fails with exit 1 when the
#   server exists or when NAME is FAKE_MCP_FAIL.
# - All other calls print the program path, the arguments, the cwd and the
#   environment as one JSON object, then exit 0.
# - When FAKE_CLAUDE_LOG is set, each call also appends that JSON object
#   as one line to the file FAKE_CLAUDE_LOG.
use strict;
use warnings;
use Cwd qw(getcwd);
use JSON::PP;

my $json = JSON::PP->new->canonical;
my $record = $json->encode({
    program => $0,
    argv    => \@ARGV,
    cwd     => getcwd(),
    env     => \%ENV,
});

if (my $log = $ENV{FAKE_CLAUDE_LOG}) {
    open(my $fh, '>>', $log) or die "cannot open $log: $!";
    print $fh $record, "\n";
    close($fh);
}

if ("@ARGV" eq "--version" && defined $ENV{FAKE_CLAUDE_VERSION}) {
    print "$ENV{FAKE_CLAUDE_VERSION}\n";
    exit 0;
}

if (@ARGV >= 2 && $ARGV[0] eq 'auth' && $ARGV[1] eq 'login') {
    my $dir = $ENV{CLAUDE_CONFIG_DIR} or die "fake claude: auth login needs CLAUDE_CONFIG_DIR\n";
    if ($ENV{FAKE_LOGIN_FAIL}) {
        print STDERR "fake claude: login failed\n";
        exit 1;
    }
    my ($email) = "@ARGV" =~ /--email (\S+)/;
    my ($suffix) = $dir =~ m{/\.claude-([^/]+)$};
    $email = $ENV{FAKE_LOGIN_EMAIL} // $email // ($suffix // 'user') . '@example.com';
    open(my $fh, '>', "$dir/.fake-login") or die "cannot write $dir/.fake-login: $!";
    print $fh $email;
    close($fh);
    open($fh, '>', "$dir/.claude.json") or die "cannot write $dir/.claude.json: $!";
    print $fh $json->encode({ oauthAccount => {
        organizationRateLimitTier => $ENV{FAKE_LOGIN_TIER} // 'default_claude_max_5x',
        organizationType => $ENV{FAKE_LOGIN_ORG_TYPE} // 'claude_max',
    } }), "\n";
    close($fh);
    print "Login successful.\n";
    exit 0;
}

if ("@ARGV" eq "auth logout") {
    if ($ENV{FAKE_LOGOUT_FAIL}) {
        print STDERR "fake claude: logout failed\n";
        exit 1;
    }
    my $dir = $ENV{CLAUDE_CONFIG_DIR} // $ENV{HOME};
    unlink "$dir/.fake-login";
    open(my $fh, '>', "$dir/.fake-logout") or die "cannot write $dir/.fake-logout: $!";
    close($fh);
    print "Successfully logged out.\n";
    exit 0;
}

if (@ARGV == 6 && $ARGV[0] eq 'mcp' && $ARGV[1] eq 'add-json'
    && $ARGV[2] eq '-s' && $ARGV[3] eq 'user') {
    my ($name, $config) = @ARGV[4, 5];
    if (defined $ENV{FAKE_MCP_FAIL} && $ENV{FAKE_MCP_FAIL} eq $name) {
        print STDERR "fake claude: cannot add $name\n";
        exit 1;
    }
    my $file = ($ENV{CLAUDE_CONFIG_DIR} // $ENV{HOME}) . '/.claude.json';
    my $data = {};
    if (open(my $fh, '<', $file)) {
        local $/;
        $data = $json->decode(<$fh>);
        close($fh);
    }
    if (exists $data->{mcpServers}{$name}) {
        print STDERR "fake claude: MCP server $name already exists\n";
        exit 1;
    }
    $data->{mcpServers}{$name} = $json->decode($config);
    open(my $fh, '>', $file) or die "cannot write $file: $!";
    print $fh $json->pretty->encode($data);
    close($fh);
    print "Added MCP server $name to user config\n";
    exit 0;
}

if ("@ARGV" eq "auth status --json") {
    my $dir = $ENV{CLAUDE_CONFIG_DIR} // '';
    my ($name) = $dir =~ m{/\.claude-([^/]+)$};
    $name = 'main' if $dir eq '';
    if ($dir ne '' && open(my $fh, '<', "$dir/.fake-login")) {
        my $email = <$fh>;
        close($fh);
        print $json->encode({
            loggedIn         => JSON::PP::true,
            authMethod       => 'claude.ai',
            email            => $email,
            subscriptionType => 'max',
        }), "\n";
        exit 0;
    }
    if ($dir =~ /loggedout/ || !defined $name || $ENV{FAKE_LOGGED_OUT}) {
        print $json->encode({ loggedIn => JSON::PP::false }), "\n";
        exit 1;
    }
    print $json->encode({
        loggedIn         => JSON::PP::true,
        authMethod       => 'claude.ai',
        email            => "$name\@example.com",
        subscriptionType => 'max',
    }), "\n";
    exit 0;
}

if (@ARGV >= 2 && $ARGV[0] eq '-p' && $ARGV[1] eq '/usage') {
    my $dir = $ENV{CLAUDE_CONFIG_DIR} // '';
    if ($dir =~ /nousage/) {
        print STDERR "fake claude: usage fetch failed\n";
        exit 1;
    }
    sleep 30 if $dir =~ /slow/;
    select(undef, undef, undef, $ENV{FAKE_USAGE_SLEEP}) if $ENV{FAKE_USAGE_SLEEP};
    if ($dir =~ /badjson/) {
        print "this is not json\n";
        exit 0;
    }
    my $limits = defined $ENV{FAKE_USAGE_LIMITS}
        ? $json->decode($ENV{FAKE_USAGE_LIMITS})
        : [
            { kind => 'session', group => 'session', percent => 5,
              resets_at => undef, severity => 'normal', is_active => JSON::PP::false,
              scope => undef },
            { kind => 'weekly_all', group => 'weekly', percent => 11,
              resets_at => '2099-01-04T06:00:00.000000+00:00', severity => 'normal',
              is_active => JSON::PP::true, scope => undef },
            { kind => 'weekly_scoped', group => 'weekly', percent => 0,
              resets_at => '2099-01-04T06:00:00.000000+00:00', severity => 'normal',
              is_active => JSON::PP::false,
              scope => { model => { display_name => 'ExampleModel' }, surface => undef } },
        ];
    print $json->encode({ type => 'system', subtype => 'init' }), "\n";
    print $json->encode({
        type => 'assistant',
        message => { role => 'assistant', model => '<synthetic>', content => [] },
        usage_report => { rate_limits => { limits => $limits } },
    }), "\n";
    print $json->encode({ type => 'result', subtype => 'success', num_turns => 0 }), "\n";
    exit 0;
}

print $record, "\n";
