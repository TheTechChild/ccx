<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.thetechchild.ccx.refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/home/test/.local/bin/ccx</string>
		<string>usage</string>
		<string>refresh</string>
		<string>--all</string>
		<string>--background</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/claude/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>CCX_CLAUDE_BIN</key>
		<string>/opt/claude/bin/claude</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
